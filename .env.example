LITELLM_URL=http://litellm:4000
LITELLM_MASTER_KEY=replace-me
PRESIDIO_URL=http://presidio:3000
PROM_URL=http://kps-kube-prometheus-stack-prometheus.monitoring.svc:9090
PGHOST=postgres
PGPASSWORD=replace-me
ALERT_EMAIL=ops@example.com
ALERT_WEBHOOK_TOKEN=replace-me
AWS_REGION=ap-northeast-1
TARGET_NAMESPACE=default
AGENT_VERSION=v6.1.3
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo.monitoring.svc:4318
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://otel-collector:4318/v1/logs
OTEL_EXPORTER_OTLP_LOGS_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=w3-ai-agent
USE_STRUCTURED_OUTPUT=true
REQUIRE_HUMAN_APPROVAL=true
# Only for local import smoke tests and CI. Do not set this in the cluster.
SKIP_K8S_CONFIG=false
